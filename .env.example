# ─────────────────────────────────────────────────────────────
#  Vault Facturation : modèle de configuration
#  Copiez ce fichier en `.env` (ou lancez `npm run setup:env`,
#  qui génère des clés aléatoires). Ne versionnez jamais `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL. En local sans Docker : `npm run db:dev` (port 5433).
DATABASE_URL="postgresql://vault:vault@localhost:5433/vault"

# URL publique de l'application (utilisée pour les vérifications d'origine).
APP_URL="http://localhost:3000"

# Secret Auth.js (chiffrement du jeton de session). 32 caractères minimum.
#   openssl rand -base64 32
AUTH_SECRET=""
AUTH_TRUST_HOST="true"

# Chiffrement AES-256-GCM des champs sensibles (email, téléphone, adresse, secret TOTP).
#   openssl rand -base64 32
ENCRYPTION_KEY=""
ENCRYPTION_KEY_ID="k1"
# Anciennes clés gardées pour relire les données après une rotation : "k0:base64,..."
ENCRYPTION_KEYS_PREVIOUS=""

# Clé HMAC de l'index aveugle (recherche par email sans déchiffrer).
#   openssl rand -base64 32
BLIND_INDEX_KEY=""

# Niveau de log : fatal | error | warn | info | debug | trace | silent
LOG_LEVEL="info"
